# Build-time config for `vite build` (production mode): Vercel production
# AND preview deployments, and a local `pnpm build`. Committed on purpose —
# every VITE_* value is inlined into the public JS bundle, so nothing here
# is secret. Never put a real secret in a VITE_* variable.
#
# A variable set in the Vercel dashboard overrides the value here (Vite
# never overwrites env vars that already exist), so use the dashboard only
# for per-environment overrides and the operational toggles below.

# Strapi (commpassion-backoffice). Explore, the promo panel and lessons
# read it directly from the browser; its CORS allows the LMS origin.
VITE_STRAPI_URL=https://cms.commpassion.id

# The Golang API, called directly with credentials. Its session/CSRF
# cookies are SameSite=Strict, which still allows this: lms. and api. are
# the same *site* (commpassion.id). Requires the API's CORS_ALLOWED_ORIGINS
# to include https://lms.commpassion.id. (Local dev is the exception:
# localhost is a different site, hence the Vite dev proxy there.)
VITE_API_URL=https://api.commpassion.id

# MSW mocks never run in a deployed build.
VITE_USE_MOCKS=false

# Not set here: VITE_IS_COMING_SOON and VITE_MAINTENANCE_MODE are
# operational switches — flip them in the Vercel dashboard and redeploy.
# Unset means off.
