# Copy to .env.local and adjust. See README "Mocking (MSW)".

# Intercept API calls with MSW mock handlers instead of hitting a real
# backend. Set to "true" for local development until Epic 8 wires up the
# real Strapi/Golang backends.
VITE_USE_MOCKS=true

# When "true", the Login page hides all sign-in options (form, sign-up
# link) and shows a "coming soon" notice instead. "Explore Online Courses"
# stays visible either way.
VITE_IS_COMING_SOON=false

# When "true", every route shows the Maintenance page instead of the app
# — checked before auth/routing even runs, so it works regardless of
# backend/session state. Off by default.
VITE_MAINTENANCE_MODE=false

# Strapi (commpassion-backoffice) base URL — the /explore catalog is read
# live from its public /api/courses, not mocked.
VITE_STRAPI_URL=http://localhost:1337

# Optional: point local dev at a real Golang API instead of MSW. Set
# VITE_USE_MOCKS=false, leave VITE_API_URL empty, and the dev server
# proxies /api/v1/* here (keeps the SameSite=Strict cookies working).
# e.g. DEV_API_PROXY_TARGET=https://api.commpassion.id
DEV_API_PROXY_TARGET=

# Midtrans Snap client key (Ticket #68) — public by design, but there's no
# real sandbox/production key yet. Leave empty until one exists; Buy Now
# shows a clear "payments aren't configured yet" message until then.
VITE_MIDTRANS_CLIENT_KEY=

# Set to "true" to load Snap.js from Midtrans's production host instead
# of the sandbox one. Leave "false" until go-live.
VITE_MIDTRANS_IS_PRODUCTION=false

# URL of the post-login introduction video shown to new users on the
# Dashboard. Leave empty until the real asset exists; the play button
# stays disabled with a clear message in that case.
VITE_INTRO_VIDEO_URL=
